{
  "_default": [
    { "icon": "", "launch": ["kitty", "kitty"] },
    { "icon": "", "launch": ["org.gnome.Nautilus", "nautilus"] },
    { "icon": "", "launch": ["firefox-esr", "firefox"] }
  ],
  "spotify": [
    { "icon": "󰒮", "exec": ["playerctl", "-p", "spotify", "previous"] },
    { "icon": "󰐎", "exec": ["playerctl", "-p", "spotify", "play-pause"] },
    { "icon": "󰒭", "exec": ["playerctl", "-p", "spotify", "next"] },
    { "icon": "", "exec": ["playerctl", "-p", "spotify", "shuffle", "Toggle"] }
  ],
  "firefox-esr": [
    { "icon": "󰝜", "keys": "CTRL,T" },
    { "icon": "󰭌", "keys": "CTRL,W" },
    { "icon": "󰃀", "keys": "CTRL,D" },
    { "icon": "󰑓", "keys": "CTRL,R" }
  ],
  "com.microsoft.vscode": [
    { "icon": "", "keys": "CTRL,P" },
    { "icon": "󰆍", "keys": "CTRL SHIFT,0" },
    { "icon": "󰞷", "keys": "CTRL SHIFT,P" },
    { "icon": "󱂪", "keys": "CTRL,B" }
  ],
  "org.gnome.nautilus": [
    { "icon": "󰉗", "keys": "CTRL SHIFT,N" },
    { "icon": "󱞊", "keys": "CTRL,H" },
    { "icon": "󱧪", "keys": "ALT,Up" },
    { "icon": "󰥨", "keys": "CTRL,L" }
  ],
  "kitty": [
    { "icon": "󰝜", "keys": "CTRL SHIFT,T" },
    { "icon": "󰭋", "keys": "CTRL SHIFT,Q" },
    { "icon": "󰆏", "keys": "CTRL SHIFT,C" },
    { "icon": "󰆒", "keys": "CTRL SHIFT,V" }
  ],
  "gimp": [
    { "icon": "󰃣", "keys": ",P" },
