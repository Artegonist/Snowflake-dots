    { "icon": "󰇾", "keys": "SHIFT,E" },
    { "icon": "󰆏", "keys": ",C" }
  ],
  "org.telegram.desktop": [
    { "icon": "", "keys": "CTRL SHIFT,Tab" },
    { "icon": "", "keys": "CTRL,Tab" },
