 {
    "layer": "top",
    "position": "top",
    "width": 1920,
    "height": 27,
    "spacing": 6,
    "modules-left": [
        "hyprland/workspaces",
        "group/player"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/sysinfo",
        "backlight",
        "pulseaudio",
        "bluetooth",
        "network",
        "hyprland/language",
        "custom/battery",
        "custom/power"
    ],
    "group/player": {
        "orientation": "horizontal",
        "spacing": 10,
        "modules": [
            "custom/prevbutton",
            "custom/playbutton",
            "custom/nextbutton"
        ]
    },
    "custom/playbutton": {
        "exec": "~/.config/waybar/scripts/playbutton.sh",
        "return-type": "json",
        "on-click": "playerctl play-pause",
        "restart-interval": 5,
        "signal": 8,
        "interval": 1,
        "tooltip": false
    },
    "custom/prevbutton": {
        "format": "󰒮",
        "on-click": "playerctl previous",
        "tooltip": false
    },
    "custom/nextbutton": {
        "format": "󰒭",
        "on-click": "playerctl next",
        "tooltip": false
    },
    
    "clock": {
        "format": "{:%H:%M:%S}",
        "interval": 1,
        "on-click": "qs -c hub-module ipc call hub toggle",
        "tooltip": false
    },	
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "qs -c audio-module ipc call audio toggle",
        "on-scroll-up": "qs -c osd-module ipc call osd incVolume -1",
        "on-scroll-down": "qs -c osd-module ipc call osd incVolume 1",
        "smooth-scrolling-threshold": 1,
        "tooltip": false
    },
    "hyprland/workspaces": {
        "on-click": "activate",
        "tooltip": false
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": " EN",
        "format-ru": " RU",
        "format-da": " DK",
        "on-click": "hyprctl switchxkblayout current next",
        "tooltip": false
    },
    "custom/power": {
        "format":  " ",
        "on-click": "qs -c power-menu ipc call powermenu toggle",
        "tooltip": false
    },
    "network": {
        "interface": "wlp0s20f3",
        "format": "{icon}",
        "on-click": "qs -c wifi-panel ipc call wifi toggle",
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰈀 Проводная",
        "format-disconnected": "󰤭 Нет сети",
        "format-disabled": "󰤮 Отключен",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "interval": 1,
        "tooltip": false
    },
    "bluetooth": {
        "format": " 󰂯 ",
        "format-disabled": " 󰂲 ",
        "format-on": " 󰂯 ",
        "format-connected": " 󰂱 {device_alias} ",
        "on-click": "qs -c bluetooth-panel ipc call bluetooth toggle",
        "interval": 1,
        "tooltip": false
    },
    "cava": {
        "cava_config": "/home/artegonist/.config/cava/waybar_cava.conf",
        "input_delay": 2,
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    }, 
    "backlight": {
        "tooltip": false,
        "reverse-scrolling": true,
        "format": " {icon} {percent}% ",
        "format-icons": [
            "󱩎",
            "󱩏",
            "󱩐",
            "󱩑",
            "󱩒",
            "󱩓",
            "󱩔",
            "󱩕",
            "󱩖",
            "󰛨"
        ],
    }, 
    "group/sysinfo": {
        "orientation": "horizontal",
        "spacing": 14,
        "modules": [
            "temperature",
            "memory",
            "cpu"
        ]
    },
    "memory": {
    	"interval": 5,
        "tooltip": false,
        "on-click": "qs -c system-info ipc call sysinfo toggle",
    	"format": "{icon} {percentage}%",
    	"format-icons":[""]
    },
    "cpu": {
    	"interval": 5,
        "tooltip": false,
        "on-click": "qs -c system-info ipc call sysinfo toggle",
        "format": "{icon} {usage}%",
        "format-icons":[""]
    },
    "temperature": {
        "interval": 5,
        "tooltip": false,
        "on-click": "qs -c system-info ipc call sysinfo toggle",
        "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",       
        "format": "{icon} {temperatureC}°",
        "format-icons": ["","","",""]
    },
    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery-watch.sh",
        "return-type": "json",
        "on-click": "qs -c battery-panel ipc call batteryPanel toggle",
        "restart-interval": 5,
        "tooltip": false
    }
}
