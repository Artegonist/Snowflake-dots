{
    "layer": "top",
    "position": "top",
    "height": 27,
    "spacing": 6,
    "modules-left": [
        "hyprland/workspaces",
        "custom/layout",
        "group/player",
        "custom/petbutton",
        "wlr/taskbar"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/sysinfo",
        "backlight",
        "pulseaudio",
        "bluetooth",
        "network",
        "hyprland/language",
        "custom/battery",
        "custom/power"
    ],
    "group/player": {
        "orientation": "horizontal",
        "spacing": 0,
        "modules": [
            "custom/prevbutton",
            "custom/playbutton",
            "custom/nextbutton"
        ]
    },
    "custom/petbutton": {
        "format": "",
        "tooltip": false,
        "on-click": "qs -c pet-habitat ipc call petModule toggle"
    },
    "custom/layout": {
        "exec": "~/.config/hypr/scripts/toggle_layout.sh show",
        "format": "{}",
        "interval": 10,
        "max-length": 9,
        "min-length": 9,
        "signal": 9,
        "on-click": "~/.config/hypr/scripts/toggle_layout.sh next",
        "exec-on-event": false,
        "tooltip": false
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "on-click":"activate",
        "on-click-right": "~/.config/waybar/scripts/window-menu.sh",
        "ignore-list": ["kitty"],
        "squash-list": ["*"],
        "interval": 1,
        "sort-by-app-id": true,
        "tooltip": false
    },
    "custom/playbutton": {
        "exec": "~/.config/waybar/scripts/playbutton.sh",
        "return-type": "json",
        "on-click": "~/.config/waybar/scripts/playbutton.sh toggle",
        "on-click-right": "qs -c player-module ipc call player toggle",
        "signal": 8,
        "interval": 0.1,
        "tooltip": false
    },
    "custom/prevbutton": {
        "format": "󰒮",
        "on-click": "~/.config/waybar/scripts/playbutton.sh previous",
        "on-click-right": "qs -c player-module ipc call player toggle",
        "tooltip": false
    },
    "custom/nextbutton": {
        "format": "󰒭",
        "on-click": "~/.config/waybar/scripts/playbutton.sh next",
        "on-click-right": "qs -c player-module ipc call player toggle",
        "tooltip": false
    },
    
    "clock": {
        "format": "{:%H:%M:%S}",
        "interval": 1,
        "on-click": "qs -c hub-module ipc call hub toggle",
        "tooltip": false
    },	
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "qs -c audio-module ipc call audio toggle",
        "on-scroll-up": "qs -c osd-module ipc call osd incVolume -1",
        "on-scroll-down": "qs -c osd-module ipc call osd incVolume 1",
        "smooth-scrolling-threshold": 1,
        "tooltip": false,
        "min-length": 6,
        "max-length": 6
    },
    "hyprland/workspaces": {
        "on-click": "activate",
        "tooltip": false
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": " EN",
        "format-ru": " RU",
        "format-da": " DK",
        "on-click": "hyprctl switchxkblayout current next",
        "tooltip": false
    },
    "custom/power": {
        "format":  "",
        "on-click": "qs -c power-menu ipc call powermenu toggle",
        "tooltip": false
    },
    "network": {
        "format": "{icon}",
        "on-click": "qs -c wifi-panel ipc call wifi toggle",
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤮",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "interval": 1,
        "tooltip": false,
        "max-length": 9,
        "min-length": 9
    },
    "bluetooth": {
        "format": " 󰂯 ",
        "format-off": " 󰂲 ",
        "format-on": " 󰂯 ",
        "format-connected": " 󰂱 ",
        "on-click": "qs -c bluetooth-panel ipc call bluetooth toggle",
        "interval": 1,
        "tooltip": false
    },
    "backlight": {
        "tooltip": false,
        "reverse-scrolling": true,
        "format": " {icon} {percent}% ",
        "format-icons": [
            "󱩎",
            "󱩏",
            "󱩐",
            "󱩑",
            "󱩒",
            "󱩓",
            "󱩔",
            "󱩕",
            "󱩖",
            "󰛨"
        ],
        "min-length": 8,
        "max-length": 8
    }, 
    "group/sysinfo": {
        "orientation": "horizontal",
        "spacing": 14,
        "modules": [
            "temperature",
            "memory",
            "cpu"
        ]
    },
    "memory": {
    	"interval": 5,
        "tooltip": false,
        "on-click": "qs -c system-info ipc call sysinfo toggle",
    	"format": "{icon} {percentage}%",
    	"format-icons":[""]
    },
    "cpu": {
    	"interval": 5,
        "tooltip": false,
        "on-click": "qs -c system-info ipc call sysinfo toggle",
        "format": "{icon} {usage}%",
        "format-icons":[""]
    },
    "temperature": {
        "interval": 5,
        "tooltip": false,
        "on-click": "qs -c system-info ipc call sysinfo toggle",
        "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",       
        "format": "{icon} {temperatureC}°",
        "format-icons": ["","","",""]
    },
    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery-watch.sh",
        "return-type": "json",
        "on-click": "qs -c battery-panel ipc call batteryPanel toggle",
        "restart-interval": 5,
        "tooltip": false
    }
}
