    readonly property var polys: logo.data100.split("|").map(s => s.trim().split(" ").map(Number))

    onColorChanged: logo.requestPaint()
    onWidthChanged: logo.requestPaint()
    onHeightChanged: logo.requestPaint()

    onPaint: {
        const ctx = getContext("2d")
        ctx.reset()
        const s = Math.min(width, height) / 100
        if (s <= 0) return
        const ox = (width - 100 * s) / 2
        const oy = (height - 100 * s) / 2
        ctx.fillStyle = logo.color
        ctx.fillRule = Qt.OddEvenFill
        ctx.beginPath()
        for (const p of logo.polys) {
            if (p.length < 6) continue
            ctx.moveTo(ox + p[0] * s, oy + p[1] * s)
            for (let i = 2; i + 1 < p.length; i += 2)
                ctx.lineTo(ox + p[i] * s, oy + p[i + 1] * s)
            ctx.closePath()
        }
        ctx.fill()
    }
